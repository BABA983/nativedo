<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeDo's own strings. Telegram's strings are not declared here: :TMessagesProj supplies them
  and this client reads them through upstream's LocaleController, exactly as upstream's app does.
-->
<resources>
    <string name="login_webview_title">登录 linux.do</string>
    <string name="verification_webview_title">验证 linux.do</string>
    <string name="verification_webview_hint">网页验证后点完成，返回取消</string>
    <string name="verification_complete">完成验证</string>
    <string name="verification_session_synced">会话已同步，尚未测试写入；回复需手动发送</string>
    <string name="verification_not_completed">请等站点页面加载完成并完成网页验证后再试</string>
    <string name="app_browser_download_started">已开始下载</string>
    <string name="app_browser_download_failed">下载失败</string>
    <string name="topic_list_failed">没能读到话题列表\n点一下重试</string>
    <!--
      A page after the first that did not arrive. The footer below the last row carries it, and
      the tap reads that page again rather than the whole list.
    -->
    <string name="topic_list_more_failed">没能读到更多话题\n点一下重试</string>
    <!--
      A topic that did not arrive. The line says which kind of failure it was, because the tap
      does a different thing for each: a challenge or a lost session opens the login WebView, a
      refusal or an outage just asks again.
    -->
    <string name="topic_failed">没能读到这个话题\n点一下重试</string>
    <string name="topic_page_failed">这一页没能读出来，继续滑动会再试一次</string>
    <string name="topic_failed_challenge">站点要求完成验证\n点一下打开验证页</string>
    <string name="topic_failed_login">登录已失效\n点一下重新登录</string>
    <string name="topic_failed_forbidden">站点拒绝了这次请求\n点一下重试</string>
    <string name="topic_failed_rate_limited">请求过于频繁\n点一下重试</string>
    <string name="topic_failed_network">网络不通\n点一下重试</string>
    <string name="reply_failed_verify">打开验证页</string>
    <!--
      Upstream's appearance page is Telegram's "Chat Settings": its title and its rows talk about a
      chat list, chat backgrounds and messages. This client has topics and posts, so the words are
      replaced here - the page, its cells and its preview are still upstream's own.
    -->
    <string name="ChatSettings">外观</string>
    <string name="ChatList">话题列表</string>
    <string name="TextSizeHeader">正文字号</string>
    <string name="ChangeChatBackground">更换背景</string>
    <string name="MainTabsChats">话题</string>
    <string name="MainTabsContacts">通知</string>
    <string name="Settings">设置</string>
    <!--
      The home options menu's day/night entry. Upstream's own string and icon, labelled with the
      mode the tap takes the reader to (upstream shows "Day Mode" while the app is dark and
      "Night Mode" while it is light).
    -->
    <string name="SwitchThemeToDay">日间模式</string>
    <string name="SwitchThemeToNight">夜间模式</string>

