<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeDo's manifest. The application class and every upstream screen (PhotoViewer, Browser's
  activity, the theme styles) come from :TMessagesProj through manifest merging, so they are not
  re-declared here. What is ours:

  * the launcher entry, which is our own activity, plus the app's own topic-link routes;
  * removing upstream's launcher alias, which points at Telegram's LaunchActivity — the Telegram
    onboarding flow, not a shell this client can use;
  * removing Telegram's own deep-link entry routes (tg/tgb/tonsite/telegram.me/telegram.dog/t.me).
    This client is not a Telegram app: a `tg://` or `t.me` link must not launch it, and no Telegram
    scheme may be claimed on the site's behalf. Upstream's activities stay (they host the viewer,
    the editor and the in-app browser); only the exported entry *routes* are dropped.

  The application class is ours too: upstream's answers the app id with null, which every
  FileProvider authority is built from.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="io.github.baba983.nativedo.app.NativeDoApplication"
        tools:replace="android:name">
        <activity
            android:name="io.github.baba983.nativedo.app.NativeDoActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TMessages.Start">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              linux.do topic links, in the site's own URL shape: a link tapped anywhere opens the
              topic in this client. The host is the site this app serves; the parser re-checks the
              origin against the configured base URL, so a link that only looks like one is refused.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="linux.do"
                    android:pathPrefix="/t/" />
            </intent-filter>

            <!--
              The app's own topic aliases: `nativedo://topic/<id>[/<floor>]` and
              `linuxdo://topic/<id>[/<floor>]`. The authority `topic` is the app's own token, not a
              host, so these routes name no origin at all — the reader is already in the app. The
              parser reads the path as an id (with an optional floor) and re-validates it, exactly
              as it does for the site's own `/t/...` URLs.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nativedo" android:host="topic" />
                <data android:scheme="linuxdo" android:host="topic" />
            </intent-filter>

            <!--
              The same aliases carrying the app-owned `/t/<slug>/<id>[/<floor>]` shape. The authority
              must be the configured forum host, so the custom scheme cannot be used to point at any
              other origin — a foreign host is refused by the parser as well.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nativedo" android:host="linux.do" android:pathPrefix="/t/" />
                <data android:scheme="linuxdo" android:host="linux.do" android:pathPrefix="/t/" />
            </intent-filter>
        </activity>

        <!--
          Telegram's shell and share screens export the Telegram deep-link routes (tg, tgb, tonsite,
          telegram.me/.dog/t.me). This client must claim none of them: the activities themselves are
          kept because upstream's viewer/editor/browser glue reaches them, but their external entry
          routes are removed here rather than by editing the upstream subtree. Each removal repeats
          the filter's own actions, categories and data, which is how the merger identifies it.
        -->
        <activity android:name="org.telegram.ui.LaunchActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="telegram.me" android:scheme="http" />
                <data android:host="telegram.me" android:scheme="https" />
                <data android:host="telegram.dog" android:scheme="http" />
                <data android:host="telegram.dog" android:scheme="https" />
                <data android:host="t.me" android:scheme="http" />
                <data android:host="t.me" android:scheme="https" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tonsite" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tg" />
            </intent-filter>
        </activity>

        <activity android:name="org.telegram.ui.ShareActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tgb" />
            </intent-filter>
        </activity>

        <!--
          Upstream declares one activity-alias per launcher icon and switches between them at
          runtime. This client has its own icon and its own launcher, so they are removed rather
          than left disabled: LauncherIconController would otherwise be free to enable one and
          replace the app's icon with Telegram's.
        -->
        <activity-alias android:name="org.telegram.messenger.DefaultIcon" tools:node="remove" />
        <activity-alias android:name="org.telegram.messenger.VintageIcon" tools:node="remove" />
        <activity-alias android:name="org.telegram.messenger.AquaIcon" tools:node="remove" />
        <activity-alias android:name="org.telegram.messenger.PremiumIcon" tools:node="remove" />
        <activity-alias android:name="org.telegram.messenger.TurboIcon" tools:node="remove" />
        <activity-alias android:name="org.telegram.messenger.NoxIcon" tools:node="remove" />
    </application>
</manifest>