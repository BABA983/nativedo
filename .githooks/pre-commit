#!/usr/bin/env bash
# Repo hook: run the Telegram hook guard before every commit.
#
# Installed by `git config core.hooksPath .githooks` (.agents/setup does this
# automatically). Keep it fast: the full check belongs in CI, not here.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/telegram-hook-guard.sh"
