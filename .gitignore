.DS_Store
*.iml

.idea/
.gradle/
.kotlin/
local.properties

build/
**/build/

captures/
.externalNativeBuild/
.cxx/

*.jks
*.keystore

.ace-tool/
.superpowers/

# pi-lens runtime state (generated). lsp.json is intentional config — kept tracked.
.pi-lens/*
!.pi-lens/lsp.json
.codex/
.pi/
.claude/
.openclaude/
skills-lock.json

# Orb lifecycle: only the committed setup/resume hooks, the rest is local state.
.agents/*
!.agents/setup
!.agents/resume

# Orb portal registration files (generated at runtime).
.amp/portals/

# Python bytecode from the scripts/ vendor tooling.
__pycache__/

# Atomic-write temp files from the vendor overlay writers.
.vendor-overlay.json.*.tmp

# Paparazzi golden images are committed per platform; only the unused video
# baseline directory stays local.
apps/android/app/src/test/snapshots/*/videos/

.tmp-home/
.tmp-robolectric/

# Legacy location of the pristine Telegram checkout. scripts/vendor-setup.sh
# now clones it next to the repo (default ../telegram); keep the rule so
# a leftover in-repo tree is never committed.
/vendor/
