#!/usr/bin/env bash
# Orb setup for linuxdo-native.
#
# Runs once per fresh orb (and again when a stale snapshot is refreshed), then
# the resulting filesystem is snapshotted. Installs the Android toolchain,
# warms the Gradle/Maven/Robolectric caches so agents can build and test
# without downloads, and checks out the pristine Telegram tree used by the
# vendor tooling.
#
# Amp kills setup after 20 minutes and only publishes the snapshot when the
# script exits 0, so the expensive warm-ups run under the budget below: a phase
# that stalls costs its own timeout, and whatever already finished still lands
# in the snapshot.
#
# Non-interactive, idempotent, no long-lived processes.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRADLE_PROJECT="$REPO_ROOT/apps/android"
GRADLEW="$GRADLE_PROJECT/gradlew"
ANDROID_SDK_DIR="${ANDROID_HOME:-$HOME/Android/Sdk}"
CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip"
ANDROID_PLATFORM="platforms;android-35"
ANDROID_BUILD_TOOLS="build-tools;34.0.0"
JDK_PACKAGE="openjdk-17-jdk-headless"

SECONDS=0
log() { printf '\n[%s +%ss] %s\n' "$(date +%H:%M:%S)" "$SECONDS" "$*"; }

# --- Phase budget ------------------------------------------------------------
# 17 minutes of a 20 minute window, leaving room for the last phase and the
# trailing bookkeeping. Every costly step goes through run_phase, which caps the
# step and returns even when the step fails, times out, or has no budget left.
SETUP_BUDGET_SECONDS="${NATIVEDO_SETUP_BUDGET_SECONDS:-1020}"
VENDOR_RESERVE_SECONDS=180
budget_left() {
  local left=$(( SETUP_BUDGET_SECONDS - SECONDS ))
  (( left < 0 )) && left=0
  printf '%s' "$left"
}
# Upper bound for a phase, never robbing the reserve kept for later phases.
cap_phase() {
  local want="$1" reserve="${2:-0}" left
  left=$(( $(budget_left) - reserve ))
  (( left < 0 )) && left=0
  (( want > left )) && want=$left
  printf '%s' "$want"
}
run_phase() { # <label> <timeout-seconds> <command...>
  local label="$1" want="$2"
  shift 2
  if (( want < 30 )); then
    log "Skipped: $label (no budget left)"
    return 0
  fi
  log "$label (timeout ${want}s, budget left $(budget_left)s)"
  if timeout --signal=TERM --kill-after=15s "$want" "$@"; then
    log "Finished: $label (elapsed ${SECONDS}s)"
  else
    log "WARNING: $label was stopped after ${want}s; caches keep whatever it finished."
  fi
}
gradle_warm() { # <timeout-seconds> <gradle args...>
  local want="$1"
  shift
  run_phase "gradlew $*" "$want" \
    "$GRADLEW" -p "$GRADLE_PROJECT" --no-daemon --console=plain "$@"
}

# --- System packages ---------------------------------------------------------
# AGP 8.6 and Kotlin 2.1 both target JVM 17, so a JDK 17+ is required.
need_jdk=1
if command -v javac >/dev/null 2>&1; then
  javac_major="$(javac -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
  if [[ "$javac_major" =~ ^[0-9]+$ ]] && (( javac_major >= 17 )); then
    need_jdk=0
  fi
fi
if (( need_jdk )) || ! command -v unzip >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  log "Installing system packages (${JDK_PACKAGE}, unzip)"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$JDK_PACKAGE" unzip curl
else
  log "JDK present: $(javac -version 2>&1)"
fi

# --- Android SDK -------------------------------------------------------------
sdkmanager_missing() { [[ ! -x "$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ]]; }
sdk_packages_missing() {
  [[ ! -d "$ANDROID_SDK_DIR/platform-tools" ||
     ! -d "$ANDROID_SDK_DIR/platforms/android-35" ||
     ! -d "$ANDROID_SDK_DIR/build-tools/34.0.0" ]]
}

if sdkmanager_missing || sdk_packages_missing; then
  export ANDROID_HOME="$ANDROID_SDK_DIR" ANDROID_SDK_ROOT="$ANDROID_SDK_DIR"
  if sdkmanager_missing; then
    log "Installing Android command-line tools into $ANDROID_SDK_DIR"
    mkdir -p "$ANDROID_SDK_DIR/cmdline-tools"
    tmp_dir="$(mktemp -d)"
    curl -fsSL -o "$tmp_dir/cmdline-tools.zip" "$CMDLINE_TOOLS_URL"
    unzip -q -o "$tmp_dir/cmdline-tools.zip" -d "$ANDROID_SDK_DIR/cmdline-tools"
    rm -rf "$tmp_dir" "$ANDROID_SDK_DIR/cmdline-tools/latest"
    mv "$ANDROID_SDK_DIR/cmdline-tools/cmdline-tools" "$ANDROID_SDK_DIR/cmdline-tools/latest"
  fi
  sdkmanager="$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager"
  log "Installing SDK packages: $ANDROID_PLATFORM $ANDROID_BUILD_TOOLS platform-tools"
  # `yes` gets SIGPIPE once sdkmanager has read the licenses it needs; pipefail
  # would turn that into a spurious failure. The install below is the real check.
  set +o pipefail
  yes | "$sdkmanager" --licenses >/dev/null 2>&1 || true
  set -o pipefail
  "$sdkmanager" --install "$ANDROID_PLATFORM" "$ANDROID_BUILD_TOOLS" "platform-tools" 2>&1 |
    tr '\r' '\n' | tail -n 2
else
  log "Android SDK present at $ANDROID_SDK_DIR"
fi

# Gradle needs either ANDROID_HOME or sdk.dir; local.properties is gitignored
# and makes builds work in shells that never sourced a profile.
local_props="$GRADLE_PROJECT/local.properties"
if [[ -f "$local_props" ]] && grep -q '^sdk\.dir=' "$local_props"; then
  if ! grep -qxF "sdk.dir=$ANDROID_SDK_DIR" "$local_props"; then
    sed -i -E "s|^sdk\.dir=.*$|sdk.dir=$ANDROID_SDK_DIR|" "$local_props"
  fi
else
  mkdir -p "$(dirname "$local_props")"
  printf 'sdk.dir=%s\n' "$ANDROID_SDK_DIR" >>"$local_props"
fi

# --- Persist the toolchain environment for later login shells ----------------
# Amp and supervised services start in fresh non-interactive login shells, which
# would otherwise not see the SDK.
env_marker="# linuxdo-native orb toolchain (managed by .agents/setup)"
env_block="$env_marker
export ANDROID_HOME=\"${ANDROID_SDK_DIR}\"
export ANDROID_SDK_ROOT=\"${ANDROID_SDK_DIR}\"
export PATH=\"\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin:\$PATH\"
if command -v javac >/dev/null 2>&1; then
  export JAVA_HOME=\"\$(dirname \"\$(dirname \"\$(readlink -f \"\$(command -v javac)\")\")\")\"
fi"
for profile in "$HOME/.bash_profile" "$HOME/.bashrc"; do
  if ! grep -qF "$env_marker" "$profile" 2>/dev/null; then
    printf '\n%s\n' "$env_block" >>"$profile"
  fi
done
log "Toolchain environment exported to ~/.bash_profile and ~/.bashrc"

# --- Keep a page cache on a small orb ----------------------------------------
# The Gradle and Kotlin daemons are the biggest memory users in an orb. On a
# 2 vCPU / 4 GB orb the repo's two 2 GB heap settings leave the kernel almost no
# page cache, and a cold build then thrashes on disk instead of compiling (a
# Kotlin task that needs ~75s with free memory can stall for the whole budget).
# The cap goes into the user-level Gradle file, so the repo's gradle.properties
# and local developer machines stay untouched. Bigger orbs skip it.
gradle_user_props="$HOME/.gradle/gradle.properties"
mem_total_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
mem_total_kb="${mem_total_kb:-0}"
if (( mem_total_kb < 6000000 )); then
  log "Small orb ($(( mem_total_kb / 1024 )) MiB RAM): capping daemon heaps in $gradle_user_props"
  mkdir -p "$(dirname "$gradle_user_props")"
  if ! grep -qF 'linuxdo-native orb memory cap' "$gradle_user_props" 2>/dev/null; then
    cat >>"$gradle_user_props" <<'EOF'

# linuxdo-native orb memory cap (managed by .agents/setup): on a small orb two
# 2 GB daemon heaps starve the page cache and stall cold builds.
org.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8
kotlin.daemon.jvmargs=-Xmx1024m
EOF
  fi
else
  log "Orb RAM $(( mem_total_kb / 1024 )) MiB: keeping the repo's JVM settings"
fi

# --- Warm Gradle, Maven, and Robolectric caches ------------------------------
# A cold build downloads the Gradle distribution, the AndroidX/Compose
# dependency set, and the Robolectric android-all jars. Doing that here keeps
# the results in the orb snapshot instead of in an agent's first task. Each
# phase is capped: a cold build on a 2 vCPU orb can run longer than the whole
# setup window, and a phase that overruns must not cost us the snapshot.
log "Warming Gradle caches (:app:assembleDebug; cold builds take minutes)"
gradle_warm "$(cap_phase 660 "$VENDOR_RESERVE_SECONDS")" :app:assembleDebug

# The full suite does not fit the budget (77 Robolectric classes plus 20
# Paparazzi goldens) and is not needed to warm caches: compiling the test source
# set pulls the test classpath, and one Robolectric class per SDK level the
# suite uses (28 through @Config, 34 through
# app/src/test/resources/robolectric.properties) pulls its android-all jar into
# ~/.m2. A failing test in the checkout is reported and tolerated.
log "Warming unit-test toolchain (Robolectric android-all jars for SDK 28 and 34)"
gradle_warm "$(cap_phase 300 "$VENDOR_RESERVE_SECONDS")" \
  :app:testDebugUnitTest \
  --tests 'io.github.baba983.nativedo.ui.topic.TopicListAdapterTest' \
  --tests 'io.github.baba983.nativedo.feature.topic.data.TopicViewportStoreTest'

# --- Pristine Telegram tree (optional, used by scripts/vendor-*.sh) ----------
# It lives outside the repo (default: a sibling `../telegram`) so the
# large checkout never bloats the working tree. scripts/vendor-setup.sh owns
# the resolution; NATIVEDO_TELEGRAM_VENDOR_DIR overrides it.
VENDOR_DIR="$(
  PYTHONPATH="$REPO_ROOT/scripts" NATIVEDO_ROOT="$REPO_ROOT" python3 -c \
    'from vendorlib import vendor_dir; print(vendor_dir())'
)"
if [[ ! -d "$VENDOR_DIR/.git" && ! -f "$VENDOR_DIR/.git" ]]; then
  log "Cloning pristine Telegram tree for vendor tooling into $VENDOR_DIR"
  run_phase "scripts/vendor-setup.sh" "$(cap_phase 600)" "$REPO_ROOT/scripts/vendor-setup.sh"
  if [[ ! -d "$VENDOR_DIR/.git" && ! -f "$VENDOR_DIR/.git" ]]; then
    if [[ -n "$VENDOR_DIR" ]]; then
      rm -rf "$VENDOR_DIR"
    fi
    echo "WARNING: vendor clone did not finish; vendor tooling needs scripts/vendor-setup.sh (the app builds without it)."
  fi
else
  log "Vendor tree present: $(git -C "$VENDOR_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
fi

# --- Repo git hooks ----------------------------------------------------------
# .githooks/pre-commit runs the vendor guard, so agent commits are checked even
# though .git/hooks itself is never committed.
if [[ -d "$REPO_ROOT/.githooks" ]]; then
  git -C "$REPO_ROOT" config core.hooksPath .githooks
  log "Installed repo git hooks (.githooks/pre-commit)"
fi

# --- Orb-specific agent notes -------------------------------------------------
guidance="$HOME/.config/amp/AGENTS.md"
guidance_marker="<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->"
if ! grep -qF "$guidance_marker" "$guidance" 2>/dev/null; then
  log "Writing orb toolchain notes to $guidance"
  mkdir -p "$(dirname "$guidance")"
  cat >>"$guidance" <<'EOF'

<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->
## linuxdo-native orb notes

- Android toolchain is preinstalled: JDK 17, Android SDK in `$HOME/Android/Sdk` (`ANDROID_HOME` exported for login shells), and `apps/android/local.properties` already points at it. Gradle, AndroidX, Robolectric, and Paparazzi artifacts are cached in `~/.gradle` / `~/.m2`; keep those caches.
- On a small orb (under 6 GiB RAM) `.agents/setup` caps the Gradle and Kotlin daemon heaps in `~/.gradle/gradle.properties`; two 2 GiB heaps on a 4 GiB orb starve the page cache and turn builds into disk thrashing. Do not raise the caps on a small orb.
- Orbs have no emulator or device (no KVM): `adb` and instrumentation tests cannot run. Verify with `:app:testDebugUnitTest` and Paparazzi instead.
- Paparazzi goldens were recorded on macOS; on Linux orbs `:app:verifyPaparazziDebug` can fail on ~0.03% pixel drift in a few snapshots. Inspect the diff before re-recording, and record only intentional UI changes.
- `../telegram` (sibling of the repo, override with `NATIVEDO_TELEGRAM_VENDOR_DIR`) holds the pristine Telegram checkout at the pinned commit, with blob contents prefetched, so `scripts/vendor-index.sh` / `vendor-diff.sh` / the guard work immediately.
- Vendor provenance is derived: `vendor-overlay.json` is the only hand-edited file, and `.githooks/pre-commit` (installed by this setup) runs `scripts/vendor-guard.sh --quick` on every commit.
EOF
fi

log "Orb setup complete in ${SECONDS}s"
