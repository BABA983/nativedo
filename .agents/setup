#!/usr/bin/env bash
# Orb setup for linuxdo-native.
#
# Runs once per fresh orb (and again when a stale snapshot is refreshed), then
# the resulting filesystem is snapshotted. Installs the Android toolchain for
# both stacks (the old skeleton's :app and the full :nativedo subtree), prepares
# a sparse Telegram tree used by the vendor tooling, and materializes the
# subtree's pinned native dependency trees. Builds and tests stay out of setup
# so orb creation does not spend minutes compiling a checkout that may be
# replaced as soon as the orb starts.
#
# Non-interactive, idempotent, no long-lived processes.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRADLE_PROJECT="$REPO_ROOT/apps/android"
ANDROID_SDK_DIR="${ANDROID_HOME:-$HOME/Android/Sdk}"
CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip"
# Old :app stack (the shrunk skeleton and its vendor tooling).
ANDROID_PLATFORM="platforms;android-35"
ANDROID_BUILD_TOOLS="build-tools;34.0.0"
# Full :nativedo stack (the apps/android/telegram subtree): platform/build-tools
# 36 plus the NDK and CMake its arm64 library build needs.
ANDROID_PLATFORM_NATIVEDO="platforms;android-36"
ANDROID_BUILD_TOOLS_NATIVEDO="build-tools;36.0.0"
ANDROID_NDK="ndk;27.2.12479018"
ANDROID_CMAKE="cmake;3.22.1"
JDK_PACKAGE="openjdk-17-jdk-headless"

SECONDS=0
log() { printf '\n[%s +%ss] %s\n' "$(date +%H:%M:%S)" "$SECONDS" "$*"; }

# --- System packages ---------------------------------------------------------
# AGP 8.6 and Kotlin 2.1 both target JVM 17, so a JDK 17+ is required.
need_jdk=1
if command -v javac >/dev/null 2>&1; then
  javac_major="$(javac -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
  if [[ "$javac_major" =~ ^[0-9]+$ ]] && (( javac_major >= 17 )); then
    need_jdk=0
  fi
fi
if (( need_jdk )) || ! command -v unzip >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  log "Installing system packages (${JDK_PACKAGE}, unzip)"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$JDK_PACKAGE" unzip curl
else
  log "JDK present: $(javac -version 2>&1)"
fi

# --- Android SDK -------------------------------------------------------------
sdkmanager_missing() { [[ ! -x "$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ]]; }
sdk_packages_missing() {
  [[ ! -d "$ANDROID_SDK_DIR/platform-tools" ||
     ! -d "$ANDROID_SDK_DIR/platforms/android-35" ||
     ! -d "$ANDROID_SDK_DIR/platforms/android-36" ||
     ! -d "$ANDROID_SDK_DIR/build-tools/34.0.0" ||
     ! -d "$ANDROID_SDK_DIR/build-tools/36.0.0" ||
     ! -d "$ANDROID_SDK_DIR/ndk/27.2.12479018" ||
     ! -d "$ANDROID_SDK_DIR/cmake/3.22.1" ]]
}

if sdkmanager_missing || sdk_packages_missing; then
  export ANDROID_HOME="$ANDROID_SDK_DIR" ANDROID_SDK_ROOT="$ANDROID_SDK_DIR"
  if sdkmanager_missing; then
    log "Installing Android command-line tools into $ANDROID_SDK_DIR"
    mkdir -p "$ANDROID_SDK_DIR/cmdline-tools"
    tmp_dir="$(mktemp -d)"
    curl -fsSL -o "$tmp_dir/cmdline-tools.zip" "$CMDLINE_TOOLS_URL"
    unzip -q -o "$tmp_dir/cmdline-tools.zip" -d "$ANDROID_SDK_DIR/cmdline-tools"
    rm -rf "$tmp_dir" "$ANDROID_SDK_DIR/cmdline-tools/latest"
    mv "$ANDROID_SDK_DIR/cmdline-tools/cmdline-tools" "$ANDROID_SDK_DIR/cmdline-tools/latest"
  fi
  sdkmanager="$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager"
  log "Installing SDK packages: $ANDROID_PLATFORM $ANDROID_BUILD_TOOLS $ANDROID_PLATFORM_NATIVEDO $ANDROID_BUILD_TOOLS_NATIVEDO $ANDROID_NDK $ANDROID_CMAKE platform-tools"
  # `yes` gets SIGPIPE once sdkmanager has read the licenses it needs; pipefail
  # would turn that into a spurious failure. The install below is the real check.
  set +o pipefail
  yes | "$sdkmanager" --licenses >/dev/null 2>&1 || true
  set -o pipefail
  "$sdkmanager" --install "$ANDROID_PLATFORM" "$ANDROID_BUILD_TOOLS" \
    "$ANDROID_PLATFORM_NATIVEDO" "$ANDROID_BUILD_TOOLS_NATIVEDO" \
    "$ANDROID_NDK" "$ANDROID_CMAKE" "platform-tools" 2>&1 |
    tr '\r' '\n' | tail -n 2
else
  log "Android SDK present at $ANDROID_SDK_DIR"
fi

# Gradle needs either ANDROID_HOME or sdk.dir; local.properties is gitignored
# and makes builds work in shells that never sourced a profile.
local_props="$GRADLE_PROJECT/local.properties"
if [[ -f "$local_props" ]] && grep -q '^sdk\.dir=' "$local_props"; then
  if ! grep -qxF "sdk.dir=$ANDROID_SDK_DIR" "$local_props"; then
    sed -i -E "s|^sdk\.dir=.*$|sdk.dir=$ANDROID_SDK_DIR|" "$local_props"
  fi
else
  mkdir -p "$(dirname "$local_props")"
  printf 'sdk.dir=%s\n' "$ANDROID_SDK_DIR" >>"$local_props"
fi

# --- Persist the toolchain environment for later login shells ----------------
# Amp and supervised services start in fresh non-interactive login shells, which
# would otherwise not see the SDK.
env_marker="# linuxdo-native orb toolchain (managed by .agents/setup)"
env_block="$env_marker
export ANDROID_HOME=\"${ANDROID_SDK_DIR}\"
export ANDROID_SDK_ROOT=\"${ANDROID_SDK_DIR}\"
export PATH=\"\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin:\$PATH\"
if command -v javac >/dev/null 2>&1; then
  export JAVA_HOME=\"\$(dirname \"\$(dirname \"\$(readlink -f \"\$(command -v javac)\")\")\")\"
fi"
for profile in "$HOME/.bash_profile" "$HOME/.bashrc"; do
  if ! grep -qF "$env_marker" "$profile" 2>/dev/null; then
    printf '\n%s\n' "$env_block" >>"$profile"
  fi
done
log "Toolchain environment exported to ~/.bash_profile and ~/.bashrc"

# --- Keep a page cache on a small orb ----------------------------------------
# The Gradle and Kotlin daemons are the biggest memory users in an orb. On a
# 2 vCPU / 4 GB orb the repo's two 2 GB heap settings leave the kernel almost no
# page cache, and a cold build then thrashes on disk instead of compiling (a
# Kotlin task that needs ~75s with free memory can stall for the whole budget).
# The cap goes into the user-level Gradle file, so the repo's gradle.properties
# and local developer machines stay untouched. Bigger orbs skip it.
gradle_user_props="$HOME/.gradle/gradle.properties"
mem_total_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
mem_total_kb="${mem_total_kb:-0}"
if (( mem_total_kb < 6000000 )); then
  log "Small orb ($(( mem_total_kb / 1024 )) MiB RAM): capping daemon heaps in $gradle_user_props"
  mkdir -p "$(dirname "$gradle_user_props")"
  if ! grep -qF 'linuxdo-native orb memory cap' "$gradle_user_props" 2>/dev/null; then
    cat >>"$gradle_user_props" <<'EOF'

# linuxdo-native orb memory cap (managed by .agents/setup): on a small orb two
# 2 GB daemon heaps starve the page cache and stall cold builds.
org.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8
kotlin.daemon.jvmargs=-Xmx1024m
EOF
  fi
else
  log "Orb RAM $(( mem_total_kb / 1024 )) MiB: keeping the repo's JVM settings"
fi

# --- Sparse Telegram tree (optional, used by scripts/vendor-*.sh) -------------
# Vendor tooling only reads Java sources at the pinned and reference commits.
# Fetch those two baselines shallowly and materialize that subtree, avoiding the
# full repository history, all tags, and unrelated platform sources.
VENDOR_DIR="$(
  PYTHONPATH="$REPO_ROOT/scripts" NATIVEDO_ROOT="$REPO_ROOT" python3 -c \
    'from vendorlib import vendor_dir; print(vendor_dir())'
)"
if [[ ! -d "$VENDOR_DIR/.git" && ! -f "$VENDOR_DIR/.git" ]]; then
  log "Preparing sparse Telegram tree for vendor tooling (timeout 60s)"
  mkdir -p "$(dirname "$VENDOR_DIR")"
  vendor_tmp="${VENDOR_DIR}.setup-tmp"
  rm -rf "$vendor_tmp"
  pin="$(python3 -c "import json; print(json.load(open('$REPO_ROOT/vendor-overlay.json'))['upstream']['pinned_commit'])")"
  reference="$(python3 -c "import json; print((json.load(open('$REPO_ROOT/vendor-overlay.json')).get('reference') or {}).get('commit') or '')")"
  if timeout --signal=TERM --kill-after=10s 60 bash -c '
    set -euo pipefail
    git init -q "$1"
    git -C "$1" remote add origin https://github.com/DrKLO/Telegram.git
    git -C "$1" config extensions.partialClone origin
    git -C "$1" config remote.origin.promisor true
    git -C "$1" config remote.origin.partialclonefilter blob:none
    git -C "$1" sparse-checkout init --cone
    git -C "$1" sparse-checkout set TMessagesProj/src/main/java
    git -C "$1" fetch -q --depth=1 --filter=blob:none origin "$2"
    if [[ -n "$3" && "$3" != "$2" ]]; then
      git -C "$1" fetch -q --depth=1 --filter=blob:none origin "$3"
      git -C "$1" checkout -q "$3"
    fi
    git -C "$1" checkout -q "$2"
  ' _ "$vendor_tmp" "$pin" "$reference"; then
    mv "$vendor_tmp" "$VENDOR_DIR"
    log "Finished preparing sparse Telegram tree"
  else
    rm -rf "$vendor_tmp"
    echo "WARNING: sparse Telegram tree was not ready after 60s; run scripts/vendor-setup.sh when vendor tooling is needed."
  fi
else
  vendor_head="$(git -C "$VENDOR_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
  pin="$(python3 -c "import json; print(json.load(open('$REPO_ROOT/vendor-overlay.json'))['upstream']['pinned_commit'])")"
  if [[ "$vendor_head" == "$pin" ]]; then
    log "Vendor tree present at the pin: ${vendor_head:0:8}"
  else
    # A snapshot taken before a pin bump keeps the old checkout: the vendor tools
    # read blobs by commit so they never notice, but the tree on disk shows the
    # previous release to anyone who reads it. vendor-setup.sh fetches and
    # checks out the pin; bound it and never fail setup over this.
    log "Vendor tree at ${vendor_head:0:8} is not the pin (${pin:0:8}); re-checking out (timeout 180s)"
    if timeout --signal=TERM --kill-after=10s 180 "$REPO_ROOT/scripts/vendor-setup.sh"; then
      log "Vendor tree moved to $(git -C "$VENDOR_DIR" rev-parse --short HEAD)"
    else
      echo "WARNING: could not move the vendor tree to the pin; run scripts/vendor-setup.sh."
    fi
  fi
fi

# The guard byte-compares declared resources against the pin. On a blob-filtered
# checkout that needs the blob contents; without them it degrades to "N files
# not compared", so warm them here (parallel; ~5s warm, ~30s cold).
if [[ -d "$VENDOR_DIR/.git" || -f "$VENDOR_DIR/.git" ]]; then
  if timeout --signal=TERM --kill-after=10s 120 "$REPO_ROOT/scripts/vendor-setup.sh" --prefetch >/dev/null 2>&1; then
    log "Vendor blobs prefetched for the guard's resource byte comparison"
  else
    echo "WARNING: vendor blob prefetch failed; the guard will report some resources as not compared."
  fi
fi

# --- Full Telegram native dependency trees (the :nativedo spike) -------------
# `apps/android/telegram` keeps upstream's `.gitmodules` and 15 gitlink entries,
# but a fresh clone has empty dependency directories; the NDK library build (and
# the media module's `core_settings.gradle` at configure time) needs them on
# disk. `scripts/telegram-deps.sh` fetches each pinned tree from its own remote
# (never from another worktree, no prebuilt `.so`) and skips any tree already
# stamped at the pin. Best-effort and bounded: unit tests do not need the trees,
# and a slow network must not fail orb setup.
if [[ -x "$REPO_ROOT/scripts/telegram-deps.sh" ]]; then
  if timeout --signal=TERM --kill-after=10s 600 "$REPO_ROOT/scripts/telegram-deps.sh" >/dev/null 2>&1; then
    log "Telegram native dependency trees materialized"
  else
    echo "WARNING: Telegram dependency trees were not fully materialized; run scripts/telegram-deps.sh before a native build."
  fi
fi

# --- Repo git hooks ----------------------------------------------------------
# .githooks/pre-commit runs the vendor guard, so agent commits are checked even
# though .git/hooks itself is never committed.
if [[ -d "$REPO_ROOT/.githooks" ]]; then
  git -C "$REPO_ROOT" config core.hooksPath .githooks
  log "Installed repo git hooks (.githooks/pre-commit)"
fi

# --- Orb-specific agent notes -------------------------------------------------
guidance="$HOME/.config/amp/AGENTS.md"
guidance_marker="<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->"
if ! grep -qF "$guidance_marker" "$guidance" 2>/dev/null; then
  log "Writing orb toolchain notes to $guidance"
  mkdir -p "$(dirname "$guidance")"
  cat >>"$guidance" <<'EOF'

<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->
## linuxdo-native orb notes

- Android toolchain is preinstalled: JDK 17, Android SDK in `$HOME/Android/Sdk` (`ANDROID_HOME` exported for login shells), and `apps/android/local.properties` already points at it. Gradle downloads dependencies on the first relevant build or test; keep `~/.gradle` / `~/.m2` caches after that.
- On a small orb (under 6 GiB RAM) `.agents/setup` caps the Gradle and Kotlin daemon heaps in `~/.gradle/gradle.properties`; two 2 GiB heaps on a 4 GiB orb starve the page cache and turn builds into disk thrashing. Do not raise the caps on a small orb.
- Orbs have no emulator or device (no KVM): `adb` and instrumentation tests cannot run. Verify with `:app:testDebugUnitTest` and Paparazzi instead.
- Paparazzi goldens are recorded on Linux, the same environment as the orb and CI, so `:app:verifyPaparazziDebug` is a real local gate: CI runs `runUnitAndScreenshotTests` (the full unit suite plus the pixel comparison), and any diff is either an intentional UI change or a bug. Inspect it, and re-record with `:app:recordPaparazziDebug` only for intentional changes.
- `../telegram` (sibling of the repo, override with `NATIVEDO_TELEGRAM_VENDOR_DIR`) is a shallow sparse checkout of Telegram's Java sources at the pinned commit, so `scripts/vendor-index.sh` / `vendor-diff.sh` / the guard work immediately without a full upstream clone.
- Vendor provenance is derived: `vendor-overlay.json` is the only hand-edited file, and `.githooks/pre-commit` (installed by this setup) runs `scripts/vendor-guard.sh --quick` on every commit.
- The full-Telegram spike is the `apps/android/telegram` subtree (upstream, kept byte-for-byte) with our module at `apps/android/nativedo`. Build and test it from the subtree: `./apps/android/telegram/gradlew -p apps/android/telegram :nativedo:testDebugUnitTest` and `:nativedo:assembleDebug -Pandroid.injected.build.abi=arm64-v8a` (platform/build-tools 36, NDK 27.2.12479018, CMake 3.22.1 — all installed by this setup).
- A fresh clone of the subtree has empty native dependency directories (upstream's 15 gitlinks). `scripts/telegram-deps.sh` materializes each pinned tree from its own remote and stamps it (idempotent, no prebuilt `.so` copied between worktrees); run it before a native build unless this setup already did.
- `scripts/telegram-hook-guard.sh` checks that `apps/android/telegram` is pristine except for one-line `NativeDoHooks` call sites; run it before committing anything under that prefix. The older `scripts/vendor-guard.sh` still checks the `apps/android/TMessagesProj` skeleton.
EOF
fi

log "Orb setup complete in ${SECONDS}s"
