#!/usr/bin/env bash
# Orb setup for linuxdo-native.
#
# Runs once per fresh orb (and again when a stale snapshot is refreshed), then
# the resulting filesystem is snapshotted. Installs the Android toolchain for
# the active `:nativedo` build and materializes the subtree's pinned native
# dependency trees. Builds and tests stay out of setup so orb creation does not
# spend minutes compiling a checkout that may be replaced as soon as the orb
# starts.
#
# Non-interactive, idempotent, no long-lived processes.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRADLE_PROJECT="$REPO_ROOT/apps/android/telegram"
ANDROID_SDK_DIR="${ANDROID_HOME:-$HOME/Android/Sdk}"
CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip"
# The `:nativedo` build: platform/build-tools 36 plus the NDK and CMake its
# arm64 library build needs.
ANDROID_PLATFORM="platforms;android-36"
ANDROID_BUILD_TOOLS="build-tools;36.0.0"
ANDROID_NDK="ndk;27.2.12479018"
ANDROID_CMAKE="cmake;3.22.1"
JDK_PACKAGE="openjdk-17-jdk-headless"

SECONDS=0
log() { printf '\n[%s +%ss] %s\n' "$(date +%H:%M:%S)" "$SECONDS" "$*"; }

# --- System packages ---------------------------------------------------------
# AGP 8.6 and Kotlin 2.1 both target JVM 17, so a JDK 17+ is required.
need_jdk=1
if command -v javac >/dev/null 2>&1; then
  javac_major="$(javac -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
  if [[ "$javac_major" =~ ^[0-9]+$ ]] && (( javac_major >= 17 )); then
    need_jdk=0
  fi
fi
if (( need_jdk )) || ! command -v unzip >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  log "Installing system packages (${JDK_PACKAGE}, unzip)"
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$JDK_PACKAGE" unzip curl
else
  log "JDK present: $(javac -version 2>&1)"
fi

# --- Android SDK -------------------------------------------------------------
sdkmanager_missing() { [[ ! -x "$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ]]; }
sdk_packages_missing() {
  [[ ! -d "$ANDROID_SDK_DIR/platform-tools" ||
     ! -d "$ANDROID_SDK_DIR/platforms/android-36" ||
     ! -d "$ANDROID_SDK_DIR/build-tools/36.0.0" ||
     ! -d "$ANDROID_SDK_DIR/ndk/27.2.12479018" ||
     ! -d "$ANDROID_SDK_DIR/cmake/3.22.1" ]]
}

if sdkmanager_missing || sdk_packages_missing; then
  export ANDROID_HOME="$ANDROID_SDK_DIR" ANDROID_SDK_ROOT="$ANDROID_SDK_DIR"
  if sdkmanager_missing; then
    log "Installing Android command-line tools into $ANDROID_SDK_DIR"
    mkdir -p "$ANDROID_SDK_DIR/cmdline-tools"
    tmp_dir="$(mktemp -d)"
    curl -fsSL -o "$tmp_dir/cmdline-tools.zip" "$CMDLINE_TOOLS_URL"
    unzip -q -o "$tmp_dir/cmdline-tools.zip" -d "$ANDROID_SDK_DIR/cmdline-tools"
    rm -rf "$tmp_dir" "$ANDROID_SDK_DIR/cmdline-tools/latest"
    mv "$ANDROID_SDK_DIR/cmdline-tools/cmdline-tools" "$ANDROID_SDK_DIR/cmdline-tools/latest"
  fi
  sdkmanager="$ANDROID_SDK_DIR/cmdline-tools/latest/bin/sdkmanager"
  log "Installing SDK packages: $ANDROID_PLATFORM $ANDROID_BUILD_TOOLS $ANDROID_NDK $ANDROID_CMAKE platform-tools"
  # `yes` gets SIGPIPE once sdkmanager has read the licenses it needs; pipefail
  # would turn that into a spurious failure. The install below is the real check.
  set +o pipefail
  yes | "$sdkmanager" --licenses >/dev/null 2>&1 || true
  set -o pipefail
  "$sdkmanager" --install "$ANDROID_PLATFORM" "$ANDROID_BUILD_TOOLS" \
    "$ANDROID_NDK" "$ANDROID_CMAKE" "platform-tools" 2>&1 |
    tr '\r' '\n' | tail -n 2
else
  log "Android SDK present at $ANDROID_SDK_DIR"
fi

# Gradle needs either ANDROID_HOME or sdk.dir; local.properties is gitignored
# and makes builds work in shells that never sourced a profile.
local_props="$GRADLE_PROJECT/local.properties"
if [[ -f "$local_props" ]] && grep -q '^sdk\.dir=' "$local_props"; then
  if ! grep -qxF "sdk.dir=$ANDROID_SDK_DIR" "$local_props"; then
    sed -i -E "s|^sdk\.dir=.*$|sdk.dir=$ANDROID_SDK_DIR|" "$local_props"
  fi
else
  mkdir -p "$(dirname "$local_props")"
  printf 'sdk.dir=%s\n' "$ANDROID_SDK_DIR" >>"$local_props"
fi

# --- Persist the toolchain environment for later login shells ----------------
# Amp and supervised services start in fresh non-interactive login shells, which
# would otherwise not see the SDK.
env_marker="# linuxdo-native orb toolchain (managed by .agents/setup)"
env_block="$env_marker
export ANDROID_HOME=\"${ANDROID_SDK_DIR}\"
export ANDROID_SDK_ROOT=\"${ANDROID_SDK_DIR}\"
export PATH=\"\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin:\$PATH\"
if command -v javac >/dev/null 2>&1; then
  export JAVA_HOME=\"\$(dirname \"\$(dirname \"\$(readlink -f \"\$(command -v javac)\")\")\")\"
fi"
for profile in "$HOME/.bash_profile" "$HOME/.bashrc"; do
  if ! grep -qF "$env_marker" "$profile" 2>/dev/null; then
    printf '\n%s\n' "$env_block" >>"$profile"
  fi
done
log "Toolchain environment exported to ~/.bash_profile and ~/.bashrc"

# --- Bound build memory without modifying the upstream subtree ---------------
# Upstream gives Gradle an 8 GB heap. Combined with test/native allocations that
# can exhaust even a 16 GB orb. User-level properties take precedence over the
# subtree's defaults; refresh only our managed block on stale snapshots.
gradle_user_props="$HOME/.gradle/gradle.properties"
mem_total_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)"
mem_total_kb="${mem_total_kb:-0}"
if (( mem_total_kb < 6000000 )); then
  gradle_heap=1536m
else
  gradle_heap=3g
fi
log "Orb RAM $(( mem_total_kb / 1024 )) MiB: Gradle heap $gradle_heap, 2 workers in $gradle_user_props"
mkdir -p "$(dirname "$gradle_user_props")"
if [[ -f "$gradle_user_props" ]]; then
  # The old small-orb block and the current block both end at this property.
  sed -i '/^# linuxdo-native orb memory cap/,/^kotlin\.daemon\.jvmargs=/d' "$gradle_user_props"
fi
cat >>"$gradle_user_props" <<EOF
# linuxdo-native orb memory cap (managed by .agents/setup)
org.gradle.jvmargs=-Xmx$gradle_heap -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8
org.gradle.workers.max=2
org.gradle.parallel=false
kotlin.compiler.execution.strategy=in-process
kotlin.daemon.jvmargs=-Xmx1024m
EOF

# --- Full Telegram native dependency trees (the :nativedo build) -------------
# `apps/android/telegram` keeps upstream's `.gitmodules` and 15 gitlink entries,
# but a fresh clone has empty dependency directories; the NDK library build (and
# the media module's `core_settings.gradle` at configure time) needs them on
# disk. `scripts/telegram-deps.sh` fetches each pinned tree from its own remote
# (never from another worktree, no prebuilt `.so`) and skips any tree already
# stamped at the pin. Best-effort and bounded: unit tests do not need the trees,
# and a slow network must not fail orb setup.
if [[ -x "$REPO_ROOT/scripts/telegram-deps.sh" ]]; then
  if timeout --signal=TERM --kill-after=10s 600 "$REPO_ROOT/scripts/telegram-deps.sh" >/dev/null 2>&1; then
    log "Telegram native dependency trees materialized"
  else
    echo "WARNING: Telegram dependency trees were not fully materialized; run scripts/telegram-deps.sh before a native build."
  fi
fi

# --- Repo git hooks ----------------------------------------------------------
# .githooks/pre-commit runs the Telegram hook guard, so agent commits are
# checked even though .git/hooks itself is never committed.
if [[ -d "$REPO_ROOT/.githooks" ]]; then
  git -C "$REPO_ROOT" config core.hooksPath .githooks
  log "Installed repo git hooks (.githooks/pre-commit)"
fi

# --- Orb-specific agent notes -------------------------------------------------
guidance="$HOME/.config/amp/AGENTS.md"
guidance_marker="<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->"
mkdir -p "$(dirname "$guidance")"
# The managed block is always the last section of the file. Drop an older copy
# (including one written before the end marker existed) and append the current
# notes, so a resumed orb picks up changes to this script instead of keeping the
# stale toolchain description forever.
if grep -qF "$guidance_marker" "$guidance" 2>/dev/null; then
  guidance_tmp="$(mktemp)"
  awk -v marker="$guidance_marker" '$0 == marker { exit } { print }' "$guidance" >"$guidance_tmp"
  mv "$guidance_tmp" "$guidance"
fi
log "Writing orb toolchain notes to $guidance"
cat >>"$guidance" <<'EOF'

<!-- linuxdo-native orb toolchain (managed by .agents/setup) -->
## linuxdo-native orb notes

- Android toolchain is preinstalled: JDK 17+, Android SDK in `$HOME/Android/Sdk` (`ANDROID_HOME` exported for login shells), and `apps/android/telegram/local.properties` already points at it. Gradle downloads dependencies on the first relevant build or test; keep `~/.gradle` / `~/.m2` caches after that.
- `.agents/setup` caps Gradle at 3 GiB (1536 MiB below 6 GiB RAM), 2 workers and no project parallelism in `~/.gradle/gradle.properties`; Kotlin compiles in process. NativeDo tests use a 3 GiB heap and one fresh JVM per class to bound native-graphics accumulation. These are memory budgets, not universal best-practice values; do not raise them blindly.
- Orbs have no emulator or device (no KVM): `adb` and instrumentation tests cannot run. Verify with `:nativedo:testDailyDebugUnitTest` (the Robolectric host harness); CI builds the installable arm64 APK.
- The app is the `apps/android/telegram` subtree (upstream, kept byte-for-byte) with our module at `apps/android/nativedo`. Build and test it from the subtree: `./apps/android/telegram/gradlew -p apps/android/telegram :nativedo:testDailyDebugUnitTest` and `:nativedo:assembleDailyDebug -Pandroid.injected.build.abi=arm64-v8a -Pandroid.injected.testOnly=false` (platform/build-tools 36, NDK 27.2.12479018, CMake 3.22.1 — all installed by this setup).
- A fresh clone of the subtree has empty native dependency directories (upstream's 15 gitlinks). `scripts/telegram-deps.sh` materializes each pinned tree from its own remote and stamps it (idempotent, no prebuilt `.so` copied between worktrees); run it before a native build unless this setup already did.
- `scripts/telegram-hook-guard.sh` checks that `apps/android/telegram` is pristine except for one-line `NativeDoHooks` call sites; run it before committing anything under that prefix. `.githooks/pre-commit` (installed by this setup) runs it on every commit.
EOF

log "Orb setup complete in ${SECONDS}s"
