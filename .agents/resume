#!/usr/bin/env bash
# Orb resume for linuxdo-native.
#
# Runs after activation and every time a paused orb wakes, inside a 10 second
# budget. No installs here: repair the gitignored SDK pointer and report the
# required toolchain state that .agents/setup prepared.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRADLE_PROJECT="$REPO_ROOT/apps/android/telegram"
ANDROID_SDK_DIR="${ANDROID_HOME:-$HOME/Android/Sdk}"

missing=()
[[ -d "$ANDROID_SDK_DIR/platforms/android-36" ]] || missing+=("Android SDK platform 36 in $ANDROID_SDK_DIR")
[[ -d "$ANDROID_SDK_DIR/build-tools/36.0.0" ]] || missing+=("Android build-tools 36.0.0 in $ANDROID_SDK_DIR")
[[ -d "$ANDROID_SDK_DIR/ndk/27.2.12479018" ]] || missing+=("Android NDK 27.2.12479018 in $ANDROID_SDK_DIR")
[[ -d "$ANDROID_SDK_DIR/cmake/3.22.1" ]] || missing+=("CMake 3.22.1 in $ANDROID_SDK_DIR")
command -v javac >/dev/null 2>&1 || missing+=("JDK 17+")

if (( ${#missing[@]} > 0 )); then
  printf 'orb resume: toolchain incomplete: %s\n' "${missing[*]}" >&2
  printf 'orb resume: run .agents/setup to rebuild the toolchain\n' >&2
  exit 1
fi

# local.properties is gitignored, so a re-clone or a cleaned working tree can
# drop it while the SDK itself survives in the snapshot.
local_props="$GRADLE_PROJECT/local.properties"
if [[ ! -f "$local_props" ]] || ! grep -q '^sdk\.dir=' "$local_props"; then
  printf 'sdk.dir=%s\n' "$ANDROID_SDK_DIR" >"$local_props"
fi

# Shared signing key. Without apps/android/nativedo/keystore.properties the build falls back to
# this machine's Android debug key, so an APK built here cannot replace one built on another
# machine (-7). The key never enters Git: the project's NATIVEDO_KEYSTORE_B64 secret carries it,
# and it is written here rather than in .agents/setup so it stays out of the project snapshot.
signing_key="$HOME/.nativedo/nativedo-signing.jks"
keystore_properties="$REPO_ROOT/apps/android/nativedo/keystore.properties"
if [[ -n "${NATIVEDO_KEYSTORE_B64:-}" ]]; then
  umask 077
  mkdir -p "${signing_key%/*}"
  # Decode to a temporary file first: a truncated or invalid secret must not
  # replace a working key. A failure here is reported but never aborts resume.
  key_tmp="$(mktemp "${signing_key}.XXXXXX")"
  if printf '%s' "$NATIVEDO_KEYSTORE_B64" | base64 -d >"$key_tmp" 2>/dev/null && [[ -s "$key_tmp" ]]; then
    chmod 600 "$key_tmp"
    mv -f "$key_tmp" "$signing_key"
    {
      printf 'storeFile=%s\n' "$signing_key"
      printf 'storePassword=%s\n' "${NATIVEDO_KEYSTORE_PASSWORD:-}"
      printf 'keyAlias=%s\n' "${NATIVEDO_KEY_ALIAS:-androiddebugkey}"
      printf 'keyPassword=%s\n' "${NATIVEDO_KEY_PASSWORD:-${NATIVEDO_KEYSTORE_PASSWORD:-}}"
    } >"$keystore_properties"
  else
    rm -f "$key_tmp"
    echo "orb resume: NATIVEDO_KEYSTORE_B64 is not valid base64 (or decodes to nothing); keeping the existing signing key" >&2
  fi
fi
